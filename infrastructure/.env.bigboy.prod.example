# =====================================================================
# Email-Ops — bigboy deploy env (prod customer: email-ops.unicorncommander.ai)
# Copy to infrastructure/.env.bigboy.prod and fill. NEVER commit the filled file.
# =====================================================================

# --- Postgres --------------------------------------------------------
# Admin/owner role used by postgres init, Prisma migrations, and ADMIN_DATABASE_URL.
# gen: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Runtime NOBYPASSRLS app role password. Rotate the email_ops_app placeholder
# inside Postgres to this value before starting the backend with tenancy on.
# gen: openssl rand -hex 24
EMAIL_OPS_APP_PASSWORD=CHANGE_ME

# --- App basics ------------------------------------------------------
LOG_LEVEL=info
JWT_EXPIRES_IN=1d
# gen: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- Public URLs (this node) ----------------------------------------
CORS_ORIGIN=https://email-ops.unicorncommander.ai
FRONTEND_URL=https://email-ops.unicorncommander.ai

# --- Keycloak SSO (dedicated customer realm) ------------------------
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=CHANGE_ME_CUSTOMER_REALM
KEYCLOAK_CLIENT_ID=email-ops
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_CALLBACK_URL=/api/v1/auth/keycloak/callback

# --- Brigade federation ---------------------------------------------
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai
BRIGADE_EXPECTED_AUDIENCE=email-ops

# --- Tenancy / gated access -----------------------------------------
EMAIL_OPS_TENANCY_ENABLED=true
DEFAULT_WORKSPACE_ID=
EMAIL_OPS_ACCESS_LIST="CHANGE_ME_INVITED_CUSTOMER_EMAIL:OWNER"
UC_ENTITLEMENT_MODE=enforce

# --- Connected-account credential vault (AES-256-GCM) ---------------
# gen: openssl rand -base64 32   (must decode to exactly 32 bytes)
CONNECTED_ACCOUNT_ENC_KEY=CHANGE_ME

# --- Cleaner Engine link (backend -> engine) ------------------------
# CLEANER_ENGINE_TOKEN (backend) and ENGINE_SHARED_SECRET (engine) MUST match.
# gen: openssl rand -hex 32
CLEANER_ENGINE_TOKEN=CHANGE_ME
ENGINE_SHARED_SECRET=CHANGE_ME
CLEANER_ENGINE_TIMEOUT_MS=20000

# --- Garage / S3 (shared Garage, dedicated prod bucket + keys) -------
GARAGE_S3_ENDPOINT=http://unicorn-garage:3900
GARAGE_S3_REGION=us-east-1
GARAGE_S3_ACCESS_KEY=CHANGE_ME
GARAGE_S3_SECRET_KEY=CHANGE_ME
GARAGE_ARCHIVE_BUCKET=email-ops-prod-archives

# --- Engine AI -------------------------------------------------------
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=local/qwen3.5-9b
LITELLM_FRONTIER_MODEL=

# --- Mail engine (James live path) ----------------------------------
MAIL_ENGINE=james
JAMES_JMAP_URL=CHANGE_ME
JAMES_IMAP_HOST=mail.unicorncommander.ai
JAMES_IMAP_PORT=993
JAMES_IMAP_SECURITY=ssl
JAMES_SMTP_HOST=mail.unicorncommander.ai
JAMES_SMTP_PORT=587
JAMES_SMTP_SECURITY=starttls
JAMES_JMAP_BASIC=CHANGE_ME
JAMES_JMAP_BEARER=
JAMES_WEBADMIN_URL=CHANGE_ME
JAMES_WEBADMIN_JWT=CHANGE_ME
JAMES_TIMEOUT_MS=10000
JAMES_ADMIN_TIMEOUT_MS=10000
MAIL_AUTOCONFIG_DOMAINS=

# --- Engine provider OAuth clients (optional) -----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Postmark transactional outbound + webhooks ---------------------
POSTMARK_SERVER_TOKEN=CHANGE_ME
# Must match a signed sender in the prod Postmark server.
POSTMARK_FROM_EMAIL=CHANGE_ME_SIGNED_SENDER
EMAIL_WEBHOOKS_ENABLED=false
POSTMARK_WEBHOOK_SECRET=CHANGE_ME
