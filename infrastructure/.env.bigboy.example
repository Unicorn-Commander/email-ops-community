# =====================================================================
# Email-Ops — bigboy deploy env (internal: email-ops.magicunicorn.dev)
# Copy to infrastructure/.env.bigboy and fill. NEVER commit the filled file.
#   cp infrastructure/.env.bigboy.example infrastructure/.env.bigboy
# This one file is loaded into the backend + engine containers AND read by
# `docker compose --env-file` for interpolation. DATABASE_URL + CLEANER_ENGINE_URL
# are built by the compose file from the values here — do not set them here.
# =====================================================================

# --- Postgres (the compose builds DATABASE_URL from this) -------------
# gen: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Optional RLS flip override. Leave unset while EMAIL_OPS_TENANCY_ENABLED=false.
# After proof passes, rotate email_ops_app off the placeholder password and set:
# DATABASE_URL=postgresql://email_ops_app:APP_PASSWORD@email-ops-postgres:5432/emailops?schema=public
# ADMIN_DATABASE_URL is built by compose from POSTGRES_PASSWORD and remains admin.
# DATABASE_URL=

# --- App basics -------------------------------------------------------
LOG_LEVEL=info
JWT_EXPIRES_IN=1d
# gen: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- Public URLs (this node) -----------------------------------------
# Traefik serves frontend + /api same-origin on this host (see compose labels).
CORS_ORIGIN=https://email-ops.magicunicorn.dev
FRONTEND_URL=https://email-ops.magicunicorn.dev

# --- Keycloak SSO (uchub realm) --------------------------------------
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=email-ops
# From the Keycloak `email-ops` client (Credentials tab). REST admin, not browser.
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_CALLBACK_URL=/api/v1/auth/keycloak/callback

# --- Brigade federation ----------------------------------------------
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai
BRIGADE_EXPECTED_AUDIENCE=email-ops

# --- Tenancy / access -------------------------------------------------
# Keep tenancy OFF until DATABASE_URL is flipped to the NOBYPASSRLS app role.
EMAIL_OPS_TENANCY_ENABLED=false
DEFAULT_WORKSPACE_ID=0190a000-7e57-7000-8000-00000000e001
EMAIL_OPS_ACCESS_LIST="owner@example.com:OWNER,team@example.com:OWNER,*@example.com:MEMBER"
# Dogfood bootstrap: gate runs with a WARN but allows. Flip to `enforce` for the
# public tier once entitlements (incl. email-ops:vault) are emitted.
UC_ENTITLEMENT_MODE=open

# --- Connected-account credential vault (AES-256-GCM) ----------------
# Encrypts the stored Keycloak broker refresh token at rest.
# gen: openssl rand -base64 32   (must decode to exactly 32 bytes)
CONNECTED_ACCOUNT_ENC_KEY=CHANGE_ME

# --- Cleaner Engine link (backend -> engine) -------------------------
# CLEANER_ENGINE_TOKEN (backend) and ENGINE_SHARED_SECRET (engine) MUST be the
# SAME value. gen: openssl rand -hex 32
CLEANER_ENGINE_TOKEN=CHANGE_ME
ENGINE_SHARED_SECRET=CHANGE_ME
CLEANER_ENGINE_TIMEOUT_MS=20000

# --- Garage / S3 (archive-and-purge + vault; used by BOTH backend + engine) --
# Dedicated bucket + key on the suite Garage (reached over unicorn-network).
GARAGE_S3_ENDPOINT=http://unicorn-garage:3900
GARAGE_S3_REGION=us-east-1
GARAGE_S3_ACCESS_KEY=CHANGE_ME
GARAGE_S3_SECRET_KEY=CHANGE_ME
GARAGE_ARCHIVE_BUCKET=email-ops-archives

# --- Engine AI (optional; analyze degrades clean if unset) -----------
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=local/qwen3.5-9b
LITELLM_FRONTIER_MODEL=

# --- Engine provider OAuth clients (OPTIONAL) ------------------------
# Not needed for the broker-token flow (the backend passes brokered access
# tokens to the engine). Only fill if you use the engine's own OAuth routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Mail engine (James live path) ----------------------------------
MAIL_ENGINE=james
JAMES_JMAP_URL=https://mail.unicorncommander.ai/jmap
JAMES_IMAP_HOST=mail.unicorncommander.ai
JAMES_IMAP_PORT=993
JAMES_IMAP_SECURITY=ssl
JAMES_SMTP_HOST=mail.unicorncommander.ai
JAMES_SMTP_PORT=587
JAMES_SMTP_SECURITY=starttls
JAMES_JMAP_BASIC=
JAMES_JMAP_BEARER=
JAMES_WEBADMIN_URL=
JAMES_WEBADMIN_JWT=
JAMES_TIMEOUT_MS=10000
JAMES_ADMIN_TIMEOUT_MS=10000
MAIL_AUTOCONFIG_DOMAINS=

# --- Stalwart mailbox read path (OPTIONAL; degrade-clean if unset) ---
STALWART_JMAP_URL=
STALWART_JMAP_TOKEN=
STALWART_IMAP_HOST=

# --- Postmark transactional outbound (OPTIONAL) ----------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
EMAIL_WEBHOOKS_ENABLED=false
POSTMARK_WEBHOOK_SECRET=
